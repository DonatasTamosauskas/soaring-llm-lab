; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Soaring"
config/description="A VR bird game: fly by flapping, hunt smaller birds, flee bigger ones, grow."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/core/events.gd"
Game="*res://scripts/core/game.gd"
Birds="*res://scripts/core/bird_registry.gd"
Settings="*res://scripts/core/settings.gd"
VR="*res://scripts/vr/vr_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="perch"
3d_physics/layer_3="npc_birds"
3d_physics/layer_4="player"
3d_physics/layer_5="wind"
3d_physics/layer_6="ui"
3d_physics/layer_7="triggers"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=72
common/max_physics_steps_per_frame=4

[rendering]

rendering_device/driver.windows="d3d12"
rendering_device/driver.macos="vulkan"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
vrs/mode=2

[xr]

openxr/enabled=true
openxr/reference_space=2
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/foveation_eye_tracked=false
openxr/foveation_with_subsampled_images=false
openxr/extensions/user_presence=true
openxr/extensions/hand_tracking=false
openxr/extensions/hand_tracking.android=false
openxr/extensions/meta/color_space/starting_color_space=3
openxr/extensions/meta/color_space.pc=false
shaders/enabled=true
