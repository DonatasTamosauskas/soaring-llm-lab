# macOS
.AppleDouble
.DS_Store
.LSOverride

# Godot — engine caches, imports and export output are regenerated
.godot/
.export/
*.import
*.translation

# Unity — Android native build scratch (outside Library/)
.utmp/

# Build output and scratch
build/
*.log
*.tmp

# Whole-project zips made to move a build to another machine
/*.zip

# Archived agent logs (tools/lab archive): private and large, kept out of git
/raw/

# Python bytecode from tools/lab
__pycache__/
/_site/

# impeccable (design skill, installed with `npx impeccable install --scope=project`): its engine
# binary is fetched by the launcher on first use, and local settings hold this machine's hooks
/.claude/skills/impeccable/scripts/bin/
/.claude/settings.local.json
/.impeccable/config.local.json
