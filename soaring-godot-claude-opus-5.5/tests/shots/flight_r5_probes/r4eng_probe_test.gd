# 4. A 90-degree corner at speed
func test_r4_corner_at_speed() -> void:
	for sp: StringName in [&"sparrow", &"pigeon", &"eagle"]:
		fx = FX.new(self)
		await fx.setup(sp, func(w: Variant) -> void:
			w.with_ground = false
			w.add_wall(Vector3(0, 100, -20.5), Vector3(80, 80, 1.0))
			w.add_wall(Vector3(-20.5, 100, 0), Vector3(1.0, 80, 80)))
		var p := fx.player
		var pr := p.model.params
		var yaw := 45.0 * DEG
		p.start_flying(Vector3(0, 100, 0), yaw, 0.0)
		var dir := FlightMath.yaw_forward(yaw)
		p.model.reset(Vector3(0, 100, 0), dir * 0.9 * pr.v_max, yaw)
		p.rig_limited_ticks = 0
		fx.reset_comfort()
		var st := {"stuns": 0, "prev": p.mode, "last_end": -1.0, "gap_after": -1.0, "min_x": INF, "min_z": INF, "t": 0.0}
		fx.on_tick = func(tick: int, f: Variant) -> void:
			var pl: PlayerBird = f.player
			var t := tick * DT
			st["t"] = t
			if pl.mode == PlayerBird.Mode.STUNNED and st["prev"] != PlayerBird.Mode.STUNNED:
				st["stuns"] += 1
			if pl.mode == PlayerBird.Mode.FLYING and st["prev"] == PlayerBird.Mode.STUNNED:
				st["last_end"] = t
			st["prev"] = pl.mode
			st["min_x"] = minf(st["min_x"], pl.model.position.x)
			st["min_z"] = minf(st["min_z"], pl.model.position.z)
		fx.run(9.0)
		var gap := absf(FlightMath.wrap_angle(p.rig_yaw + p.wing_state().body_yaw - p.model.heading()))
		var tag := "%s corner" % sp
		_log("[corner] %s: %d stun(s), last stun ended at %.2f s, final view/heading gap %.1f deg (debt %.1f deg), rig safety net %d ticks, peak rig rate %.1f deg/s, accel %.1f deg/s^2, deepest x %.2f z %.2f (walls at -20.0), mode %s" % [
			sp, st["stuns"], st["last_end"], rad_to_deg(gap), rad_to_deg(p.view_turn.debt), p.rig_limited_ticks,
			rad_to_deg(fx.comfort["max_rate"]), rad_to_deg(fx.comfort["max_accel"]), st["min_x"], st["min_z"], p.mode_name()])
		between(float(st["stuns"]), 1.0, 2.0, "%s: one or two stuns (one per wall at most), no stun lock" % tag)
		gt(float(st["min_x"]), -20.0, "%s: never through the x wall" % tag)
		gt(float(st["min_z"]), -20.0, "%s: never through the z wall" % tag)
		lt(rad_to_deg(gap), 5.0, "%s: the view faces the heading once the stuns are over" % tag)
		eq(p.rig_limited_ticks, 0, "%s: the comfort safety net never had to act" % tag)
		fx.assert_comfort(self, tag)
		fx.teardown()
		fx = null


