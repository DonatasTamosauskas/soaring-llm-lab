# 2. Symmetric flapping near hover never spins the view
func test_r4_symmetric_hover_does_not_spin_the_view() -> void:
	for sp: StringName in [&"sparrow", &"starling"]:
		fx = FX.new(self)
		await fx.setup(sp)
		var p := fx.player
		p.start_flying(Vector3(0, 300, 0), 0.0, 0.0)
		p.model.reset(Vector3(0, 300, 0), Vector3(0, 0, -0.3 * p.model.params.v_min), 0.0)
		fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
			b.set_airplane()
			ScriptedPoseSource.flap(b, t, 50.0, 1.6)
			b.head_yaw = 0.5 * sin(0.8 * t)
			b.humanize(DT)
		var st := {"abs": 0.0, "prev": p.rig_yaw, "habs": 0.0, "hprev": p.model.heading(), "active": 0, "vh": 0.0, "n": 0,
			"owed_ticks": 0}
		fx.on_tick = func(_tick: int, f: Variant) -> void:
			var pl: PlayerBird = f.player
			st["abs"] += absf(FlightMath.wrap_angle(pl.rig_yaw - float(st["prev"])))
			st["prev"] = pl.rig_yaw
			st["habs"] += absf(FlightMath.wrap_angle(pl.model.heading() - float(st["hprev"])))
			st["hprev"] = pl.model.heading()
			if pl.view_turn.active():
				st["active"] += 1
			st["vh"] += Vector2(pl.model.velocity.x, pl.model.velocity.z).length()
			st["n"] += 1
		fx.reset_comfort()
		p.rig_limited_ticks = 0
		fx.run(12.0)
		var tag := "%s hover" % sp
		_log("[hover] %s: view turned %.1f deg in total (heading %.1f), ViewTurn active %.0f %% of ticks, mean ground speed %.2f m/s (%.2f V_min), rig safety net %d ticks, peak rig rate %.1f deg/s, accel %.1f deg/s^2" % [
			sp, rad_to_deg(st["abs"]), rad_to_deg(st["habs"]), 100.0 * st["active"] / maxf(1.0, st["n"]),
			st["vh"] / maxf(1.0, st["n"]), st["vh"] / maxf(1.0, st["n"]) / p.model.params.v_min, p.rig_limited_ticks,
			rad_to_deg(fx.comfort["max_rate"]), rad_to_deg(fx.comfort["max_accel"])])
		lt(rad_to_deg(st["abs"]), 30.0, "%s: symmetric flapping (no turn asked) turns the view < 30 deg in 12 s" % tag)
		fx.assert_comfort(self, tag)
		metric(tag, {"view_abs_deg": rad_to_deg(st["abs"]), "heading_abs_deg": rad_to_deg(st["habs"]), "net": p.rig_limited_ticks})
		fx.teardown()
		fx = null


