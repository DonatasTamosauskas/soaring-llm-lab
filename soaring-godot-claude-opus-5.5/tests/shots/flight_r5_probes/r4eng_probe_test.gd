# 8. ViewTurn inside PlayerBird: does the payout ever leave its own limits
# (120 deg/s) in play? Stress cases that owe more while a payout is running:
# a slide along a wall while the player keeps rolling into it, and a stun
# followed by a hard roll the same way the view is turning.
func _vt_watch(st: Dictionary) -> Callable:
	return func(_tick: int, f: Variant) -> void:
		var pl: PlayerBird = f.player
		st["vt_rate"] = maxf(st["vt_rate"], absf(pl.view_turn.rate))
		st["vt_acc"] = maxf(st["vt_acc"], absf(pl.view_turn.acc))
		if pl.mode == PlayerBird.Mode.STUNNED and st["prev"] != PlayerBird.Mode.STUNNED:
			st["stuns"] += 1
		st["prev"] = pl.mode
		st["contacts"] = pl.contacts["slide"] + pl.contacts["stun"]


func test_r4_viewturn_limits_in_play() -> void:
	var worst := 0.0
	for sp: StringName in [&"sparrow", &"pigeon", &"eagle"]:
		for scen in ["slide_roll_in", "stun_then_roll_with", "stun_then_roll_against"]:
			fx = FX.new(self)
			await fx.setup(sp, func(w: Variant) -> void:
				w.with_ground = false
				w.add_wall(Vector3(0, 100, -20.5), Vector3(400, 80, 1.0)))
			var p := fx.player
			var pr := p.model.params
			var cal := p.wing_input.calibration
			var inc := 15.0 if scen == "slide_roll_in" else 80.0
			var yaw := (90.0 - inc) * DEG
			var v := pr.v_c
			var start := Vector3(-v * 0.6 * cos(inc * DEG), 100, -20.0 + pr.r_body + v * 0.6 * sin(inc * DEG) + 0.02)
			p.start_flying(start, yaw, 0.0)
			p.model.reset(start, FlightMath.yaw_forward(yaw) * v, yaw)
			# yaw 75 deg flies toward -x / -z; rolling LEFT (roll < 0, heading
			# increases) turns it further into the wall.
			var roll := -1.0
			if scen == "stun_then_roll_with":
				roll = 1.0
			fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
				b.set_airplane()
				if scen == "slide_roll_in" or t > 0.9:
					b.synth(0.0, roll, 1.0, cal)
				b.humanize(DT)
			p.rig_limited_ticks = 0
			fx.reset_comfort()
			var st := {"vt_rate": 0.0, "vt_acc": 0.0, "stuns": 0, "prev": p.mode, "contacts": 0}
			fx.on_tick = _vt_watch(st)
			fx.run(5.0)
			var tag := "%s %s" % [sp, scen]
			_log("[viewturn in play] %s: contacts %d, stuns %d, ViewTurn peak rate %.1f deg/s, peak accel %.1f deg/s^2, rig safety net %d ticks, rig peak %.1f deg/s %.1f deg/s^2" % [
				tag, st["contacts"], st["stuns"], rad_to_deg(st["vt_rate"]), rad_to_deg(st["vt_acc"]), p.rig_limited_ticks,
				rad_to_deg(fx.comfort["max_rate"]), rad_to_deg(fx.comfort["max_accel"])])
			worst = maxf(worst, rad_to_deg(st["vt_rate"]))
			lt(rad_to_deg(st["vt_rate"]), 120.0 * 1.02, "%s: the owed view turn is paid inside its 120 deg/s" % tag)
			lt(rad_to_deg(st["vt_acc"]), 240.0 * 1.02, "%s: the owed view turn is paid inside its 240 deg/s^2" % tag)
			fx.assert_comfort(self, tag)
			metric(tag, {"vt_rate": rad_to_deg(st["vt_rate"]), "vt_acc": rad_to_deg(st["vt_acc"]), "net": p.rig_limited_ticks,
				"contacts": st["contacts"], "stuns": st["stuns"]})
			fx.teardown()
			fx = null
	_log("[viewturn in play] worst payout rate %.1f deg/s" % worst)


