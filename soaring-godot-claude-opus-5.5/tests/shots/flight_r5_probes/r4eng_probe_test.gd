# 9. ViewTurn during perch approaches in wind (the assist's crab is owed to
# the view every tick of the last half second: a continuous owe while a
# payout runs, the case where a re-plan can be infeasible).
const PW := preload("res://tests/unit/flight/perch_wind.gd")


func test_r4_viewturn_limits_perching_in_wind() -> void:
	var worst := 0.0
	for sp: StringName in [&"sparrow", &"pigeon", &"eagle"]:
		for wname in ["cross 2.1", "head 2.1", "tail 2.1"]:
			var wind := Vector3(2.1, 0, 0) if wname.begins_with("cross") else (Vector3(0, 0, 2.1) if wname.begins_with("head") else Vector3(0, 0, -2.1))
			fx = FX.new(self)
			await fx.setup(sp, func(w: Variant) -> void:
				w.add_perch(PW.PERCH, Vector3.FORWARD, 10.0, 0.015, 1.0)
				w.uniform_wind = wind)
			var p := fx.player
			var pr := p.model.params
			var st := {"vt_rate": 0.0, "vt_acc": 0.0, "net": 0, "over": 0, "perched": 0, "n": 0, "rig_acc": 0.0}
			var sets: Array = PW.glide_set() + PW.verifier_set()
			for c in sets:
				var cc: Dictionary = (c as Dictionary).duplicate()
				if cc.has("air_vmin"):
					cc["air"] = float(cc["air_vmin"]) * pr.v_min
				p.rig_limited_ticks = 0
				# PW.approach installs its own on_tick; watch the view through
				# the player after every fixture step instead (same ticks).
				var res := await _approach_watch(cc, st)
				st["n"] += 1
				if float(res["t"]) >= 0.0:
					st["perched"] += 1
				st["net"] += p.rig_limited_ticks
			var tag := "%s perch %s" % [sp, wname]
			_log("[viewturn perching] %s: %d approaches, %d perched, ViewTurn peak rate %.1f deg/s, accel %.1f deg/s^2, ticks above 122 deg/s %d, rig safety net %d ticks, rig accel peak %.1f deg/s^2" % [
				tag, st["n"], st["perched"], rad_to_deg(st["vt_rate"]), rad_to_deg(st["vt_acc"]), st["over"], st["net"], rad_to_deg(st["rig_acc"])])
			worst = maxf(worst, rad_to_deg(st["vt_rate"]))
			lt(rad_to_deg(st["vt_rate"]), 120.0 * 1.02, "%s: the owed view turn is paid inside its 120 deg/s" % tag)
			eq(st["net"], 0, "%s: the rig's comfort safety net never acts" % tag)
			metric(tag, st.duplicate())
			fx.teardown()
			fx = null
	_log("[viewturn perching] worst payout rate %.1f deg/s" % worst)


func _approach_watch(c: Dictionary, st: Dictionary) -> Dictionary:
	var p := fx.player
	var pr := p.model.params
	var target := PW.PERCH + Vector3.UP * pr.r_body
	var wind: Vector3 = fx.world.uniform_wind
	var pitch: float = c["pitch"]
	p.respawn(Transform3D(Basis.IDENTITY, PW.PERCH + Vector3(0, 200, 400)))
	if c.get("trim", false):
		var sol := p.model.trim_solution(pitch)
		var g0: float = sol["gamma"]
		var back: float = float(c["back"]) * pr.span
		var start := target + Vector3(0, -back * tan(g0) + float(c["off"]) * pr.span, back)
		p.start_flying(start, 0.0, pitch)
		p.model.velocity += wind
	else:
		var start := target + Vector3(0, float(c["up"]) * pr.span, float(c["back"]) * pr.span)
		p.start_flying(start, 0.0, 0.0)
		p.model.reset(start, Vector3(0, 0, -float(c["air"])) + wind, 0.0)
	fx.driver = fx.synth(pitch, 0.0, 1.0)
	fx.on_tick = Callable()
	var t := -1.0
	for i in int(round(4.0 / DT)):
		fx.step()
		var r := absf(p.view_turn.rate)
		st["vt_rate"] = maxf(st["vt_rate"], r)
		st["vt_acc"] = maxf(st["vt_acc"], absf(p.view_turn.acc))
		if not p.yaw_flagged:
			st["rig_acc"] = maxf(st["rig_acc"], absf(p.rig_yaw_accel))
		if rad_to_deg(r) > 122.0:
			st["over"] += 1
		if p.mode == PlayerBird.Mode.PERCHED:
			t = i * DT
			break
	return {"t": t}


# --------------------------------------------------------------------------
# 10. Inside a room (DESIGN: houses with open windows you fly through): a bird
# that comes in fast bounces off several walls in a row. Every stun owes the
# view a turn; a second one while the first is being paid re-plans ViewTurn
# from a moving state. Does the payout stay inside its limits and the rig's
# comfort safety net stay idle?
func test_r4_room_bounces() -> void:
	var worst := 0.0
	var worst_tag := ""
	var total_net := 0
	var n_over := 0
	var n := 0
	var n_spin := 0
	var n_ground_spin := 0
	var spin_secs: Array[float] = []
	for sp: StringName in [&"sparrow", &"pigeon"]:
		fx = FX.new(self)
		# A 4 x 2.5 x 4 m room (walls 0.2 m thick) at y 100.
		await fx.setup(sp, func(w: Variant) -> void:
			w.with_ground = false
			w.add_wall(Vector3(0, 100, -2.1), Vector3(4.4, 2.9, 0.2))
			w.add_wall(Vector3(0, 100, 2.1), Vector3(4.4, 2.9, 0.2))
			w.add_wall(Vector3(-2.1, 100, 0), Vector3(0.2, 2.9, 4.4))
			w.add_wall(Vector3(2.1, 100, 0), Vector3(0.2, 2.9, 4.4))
			w.add_wall(Vector3(0, 98.65, 0), Vector3(4.4, 0.2, 4.4))
			w.add_wall(Vector3(0, 101.35, 0), Vector3(4.4, 0.2, 4.4)))
		var p := fx.player
		var pr := p.model.params
		for k in 24:
			var yaw := k * 15.0 * DEG
			for sx in [-0.8, 0.8]:
				var start := Vector3(sx, 100.0, 0.5 * sx)
				p.start_flying(start, yaw, 0.0)
				p.model.reset(start, FlightMath.yaw_forward(yaw) * pr.v_c * 1.2, yaw)
				p.rig_limited_ticks = 0
				fx.reset_comfort()
				var st := {"vt_rate": 0.0, "vt_acc": 0.0, "stuns": 0, "prev": p.mode, "contacts": 0}
				var watch := _vt_watch(st)
				var spin := {"t": 0.0, "grounded_spin": 0.0}
				fx.on_tick = func(tick: int, f: Variant) -> void:
					watch.call(tick, f)
					var pl: PlayerBird = f.player
					if absf(pl.rig_yaw_rate) > deg_to_rad(150.0):
						spin["t"] += DT
						if pl.mode == PlayerBird.Mode.GROUNDED or pl.mode == PlayerBird.Mode.PERCHED:
							spin["grounded_spin"] += DT
				fx.run(8.0)
				n += 1
				spin_secs.append(float(spin["t"]))
				if float(spin["t"]) > 1.0:
					n_spin += 1
				if float(spin["grounded_spin"]) > 0.5:
					n_ground_spin += 1
				total_net += p.rig_limited_ticks
				if rad_to_deg(st["vt_rate"]) > 122.0:
					n_over += 1
				if rad_to_deg(st["vt_rate"]) > worst:
					worst = rad_to_deg(st["vt_rate"])
					worst_tag = "%s yaw %d start %.1f: %d stuns, %d contacts, ViewTurn %.0f deg/s %.0f deg/s^2, safety net %d ticks, rig %.0f deg/s %.0f deg/s^2" % [
						sp, int(k * 15), sx, st["stuns"], st["contacts"], rad_to_deg(st["vt_rate"]), rad_to_deg(st["vt_acc"]),
						p.rig_limited_ticks, rad_to_deg(fx.comfort["max_rate"]), rad_to_deg(fx.comfort["max_accel"])]
				fx.assert_comfort(self, "%s room yaw %d" % [sp, int(k * 15)])
		fx.teardown()
		fx = null
	spin_secs.sort()
	_log("[room] %d flights (8 s each): %d with a ViewTurn payout above 122 deg/s; %d with the view turning faster than 150 deg/s for more than 1 s (%d of them while the bird stands on the floor); longest spin %.1f s; rig safety net %d ticks in total; worst: %s" % [
		n, n_over, n_spin, n_ground_spin, spin_secs[spin_secs.size() - 1], total_net, worst_tag])
	eq(n_spin, 0, "room bounces: the view never spins (> 150 deg/s for more than 1 s)")
	eq(n_over, 0, "room bounces: the owed view turn is always paid inside its 120 deg/s")
	eq(total_net, 0, "room bounces: the rig's comfort safety net never acts")
	metric("room", {"flights": n, "over": n_over, "net": total_net, "worst": worst})


## The worst room flight of test 10, traced tick by tick (evidence).
func test_r4_room_worst_trace() -> void:
	fx = FX.new(self)
	await fx.setup(&"sparrow", func(w: Variant) -> void:
		w.with_ground = false
		w.add_wall(Vector3(0, 100, -2.1), Vector3(4.4, 2.9, 0.2))
		w.add_wall(Vector3(0, 100, 2.1), Vector3(4.4, 2.9, 0.2))
		w.add_wall(Vector3(-2.1, 100, 0), Vector3(0.2, 2.9, 4.4))
		w.add_wall(Vector3(2.1, 100, 0), Vector3(0.2, 2.9, 4.4))
		w.add_wall(Vector3(0, 98.65, 0), Vector3(4.4, 0.2, 4.4))
		w.add_wall(Vector3(0, 101.35, 0), Vector3(4.4, 0.2, 4.4)))
	var p := fx.player
	var pr := p.model.params
	var yaw := 255.0 * DEG
	var start := Vector3(0.8, 100.0, 0.4)
	p.start_flying(start, yaw, 0.0)
	p.model.reset(start, FlightMath.yaw_forward(yaw) * pr.v_c * 1.2, yaw)
	p.rig_limited_ticks = 0
	fx.reset_comfort()
	var rows := PackedStringArray(["t,mode,x,y,z,speed,heading_deg,rig_deg,rig_rate,rig_acc,vt_debt_deg,vt_rate,vt_acc,contacts,net"])
	var st := {"rig_abs": 0.0, "h_abs": 0.0, "prev_r": p.rig_yaw, "prev_h": p.model.heading(), "fast_t": 0.0, "over_t": 0.0, "max_gap": 0.0}
	fx.on_tick = func(tick: int, f: Variant) -> void:
		var pl: PlayerBird = f.player
		var m := pl.model
		st["rig_abs"] += absf(FlightMath.wrap_angle(pl.rig_yaw - float(st["prev_r"])))
		st["h_abs"] += absf(FlightMath.wrap_angle(m.heading() - float(st["prev_h"])))
		st["prev_r"] = pl.rig_yaw
		st["prev_h"] = m.heading()
		if absf(pl.rig_yaw_rate) > deg_to_rad(150.0):
			st["fast_t"] += DT
		if absf(pl.view_turn.rate) > deg_to_rad(122.0):
			st["over_t"] += DT
		st["max_gap"] = maxf(st["max_gap"], absf(FlightMath.wrap_angle(pl.rig_yaw + pl.wing_state().body_yaw - m.heading())))
		rows.append("%.3f,%s,%.3f,%.3f,%.3f,%.2f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%.1f,%d,%d" % [tick * DT, pl.mode_name(),
			m.position.x, m.position.y, m.position.z, m.velocity.length(), rad_to_deg(m.heading()), rad_to_deg(pl.rig_yaw),
			rad_to_deg(pl.rig_yaw_rate), rad_to_deg(pl.rig_yaw_accel), rad_to_deg(pl.view_turn.debt), rad_to_deg(pl.view_turn.rate),
			rad_to_deg(pl.view_turn.acc), pl.contacts["slide"] + pl.contacts["stun"] + pl.contacts["silent"], pl.rig_limited_ticks])
	fx.run(5.0)
	var spin_t := 5.0
	for i in int(55.0 / DT):
		fx.step()
		if absf(p.rig_yaw_rate) > deg_to_rad(5.0):
			spin_t = fx.ticks * DT
	_log("[room trace] the view last turned faster than 5 deg/s at t = %.1f s (of 60 s); mode %s; ViewTurn active %s, debt %.0f deg" % [
		spin_t, p.mode_name(), p.view_turn.active(), rad_to_deg(p.view_turn.debt)])
	var path := Paths.artifacts("flight").path_join("verify/r5_builder/r4eng/room_worst_trace.csv")
	var fa := FileAccess.open(path, FileAccess.WRITE)
	if fa:
		fa.store_string("\n".join(rows) + "\n")
	_log("[room trace] sparrow yaw 255: the view turned %.0f deg in total while the heading turned %.0f deg; rig above 150 deg/s for %.2f s; ViewTurn above 122 deg/s for %.2f s; worst view/heading gap %.0f deg; safety net %d ticks; contacts %s; trace %s" % [
		rad_to_deg(st["rig_abs"]), rad_to_deg(st["h_abs"]), st["fast_t"], st["over_t"], rad_to_deg(st["max_gap"]), p.rig_limited_ticks, p.contacts, path])
	lt(st["over_t"], DT * 0.5, "room trace: the owed view turn never exceeds its 120 deg/s")


