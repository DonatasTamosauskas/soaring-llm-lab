# 11. Outdoors: a low hit on a house wall standing on flat ground (the stunned
# bird drops to the ground by the wall). Same watch as test 10.
func test_r4_low_wall_hit_on_the_ground() -> void:
	var n := 0
	var n_spin := 0
	var n_over := 0
	var longest := 0.0
	var worst_tag := ""
	for sp: StringName in [&"sparrow", &"pigeon", &"eagle"]:
		fx = FX.new(self)
		await fx.setup(sp, func(w: Variant) -> void:
			w.add_wall(Vector3(0, 5, -10.1), Vector3(60, 10, 0.2)))
		var p := fx.player
		var pr := p.model.params
		for inc: float in [20.0, 35.0, 50.0, 65.0, 80.0, 90.0]:
			for h: float in [0.3, 0.8, 1.5]:
				for vk: float in [0.8, 1.0, 1.2]:
					var yaw := (90.0 - inc) * DEG
					var v := pr.v_c * vk
					var d := 1.5
					var start := Vector3(-d * cos(inc * DEG), h, -10.0 + pr.r_body + d * sin(inc * DEG))
					p.start_flying(start, yaw, 0.0)
					p.model.reset(start, FlightMath.yaw_forward(yaw) * v, yaw)
					fx.reset_comfort()
					var st := {"vt_rate": 0.0, "vt_acc": 0.0, "stuns": 0, "prev": p.mode, "contacts": 0}
					var watch := _vt_watch(st)
					var spin := {"t": 0.0}
					fx.on_tick = func(tick: int, f: Variant) -> void:
						watch.call(tick, f)
						if absf((f.player as PlayerBird).rig_yaw_rate) > deg_to_rad(150.0):
							spin["t"] += DT
					fx.run(6.0)
					n += 1
					if rad_to_deg(st["vt_rate"]) > 122.0:
						n_over += 1
					if float(spin["t"]) > 1.0:
						n_spin += 1
					if float(spin["t"]) > longest:
						longest = float(spin["t"])
						worst_tag = "%s incidence %d h %.1f v %.1f V_c: stuns %d, ViewTurn peak %.0f deg/s, spin %.1f s, end mode %s" % [
							sp, int(inc), h, vk, st["stuns"], rad_to_deg(st["vt_rate"]), spin["t"], p.mode_name()]
		fx.teardown()
		fx = null
	_log("[low wall] %d hits: %d with a ViewTurn payout above 122 deg/s, %d with the view spinning > 150 deg/s for more than 1 s; longest %.1f s: %s" % [
		n, n_over, n_spin, longest, worst_tag])
	eq(n_spin, 0, "low wall hits: the view never spins (> 150 deg/s for more than 1 s)")
	eq(n_over, 0, "low wall hits: the owed view turn is always paid inside its 120 deg/s")


# --------------------------------------------------------------------------
# 12. A perch caught in a hard, slow turn (the player banks onto the branch at
# the last moment, grip held): the capture brakes the rig's turn with
# ViewTurn.settle(). From a rig turning faster than ViewTurn's 120 deg/s the
# braking plan is infeasible. A virtual perch is placed where a first run of
# the same flight passed while turning fast and slow.
func test_r4_perch_caught_in_a_hard_turn() -> void:
	var results := PackedStringArray()
	var n_spin := 0
	var n_cap := 0
	for sp: StringName in [&"sparrow", &"pigeon"]:
		for pitch: float in [0.6, 0.8]:
			fx = FX.new(self)
			await fx.setup(sp)
			var p := fx.player
			var cal := p.wing_input.calibration
			var drv := func(_tick: int, t: float, b: HumanPoseModel) -> void:
				b.set_airplane()
				b.synth(pitch, 1.0 if t > 0.3 else 0.0, 1.0, cal)
				b.grip = Vector2(1.0, 1.0)
			# Pass 1: where does the turning bird go, and how fast does the rig turn?
			p.start_flying(Vector3(0, 50, 0), 0.0, pitch)
			fx.driver = drv
			var path: Array = []
			fx.on_tick = func(_tick: int, f: Variant) -> void:
				var pl: PlayerBird = f.player
				path.append([pl.model.position, pl.rig_yaw_rate, minf(pl.model.airspeed(), pl.model.velocity.length())])
			fx.run(3.0)
			fx.on_tick = Callable()
			var vcap := 1.4 * p.tuning.perch_capture_speed * p.model.params.v_min
			var picks: Array[int] = []
			var slow_max := 0.0
			for i in range(40, path.size()):
				if float(path[i][2]) < vcap:
					slow_max = maxf(slow_max, absf(float(path[i][1])))
				if absf(float(path[i][1])) > deg_to_rad(100.0) and float(path[i][2]) < vcap:
					picks.append(i)
			results.append("%s pitch %.1f: fastest rig turn at a capturable speed %.0f deg/s" % [sp, pitch, rad_to_deg(slow_max)])
			fx.teardown()
			fx = null
			if picks.is_empty():
				results.append("%s pitch %.1f: no slow tick turning > 100 deg/s" % [sp, pitch])
				continue
			for j in [0, picks.size() / 2, picks.size() - 1]:
				var i: int = picks[j]
				var pos: Vector3 = path[i][0]
				fx = FX.new(self)
				var r_body := SizeRules.body_radius_for_mass(FlightParams.species_mass(sp))
				await fx.setup(sp, func(w: Variant) -> void:
					w.add_virtual_perch(pos - Vector3.UP * r_body * 1.0, Vector3.FORWARD, 10.0))
				p = fx.player
				p.start_flying(Vector3(0, 50, 0), 0.0, pitch)
				fx.driver = drv
				var st := {"cap_rate": 0.0, "captured": false, "spin": 0.0, "after": 0.0}
				fx.on_tick = func(_tick: int, f: Variant) -> void:
					var pl: PlayerBird = f.player
					if not st["captured"] and pl.mode == PlayerBird.Mode.PERCHED:
						st["captured"] = true
						st["cap_rate"] = pl.rig_yaw_rate
					if st["captured"]:
						st["after"] += absf(pl.rig_yaw_rate) * DT
						if absf(pl.rig_yaw_rate) > deg_to_rad(150.0):
							st["spin"] += DT
				fx.run(8.0)
				if st["captured"]:
					n_cap += 1
					if float(st["spin"]) > 1.0:
						n_spin += 1
				results.append("%s pitch %.1f tick %d: captured %s at a rig rate of %.0f deg/s; afterwards the view turned %.0f deg, %.1f s of it faster than 150 deg/s; mode %s" % [
					sp, pitch, i, st["captured"], rad_to_deg(st["cap_rate"]), rad_to_deg(st["after"]), st["spin"], p.mode_name()])
				fx.teardown()
				fx = null
	for r in results:
		_log("[perch in a turn] " + r)
	_log("[perch in a turn] %d captures, %d followed by a view spin (> 150 deg/s for more than 1 s)" % [n_cap, n_spin])
	metric("perch_in_turn", {"captures": n_cap, "spins": n_spin})
	eq(n_spin, 0, "a perch caught in a hard turn never spins the view")
