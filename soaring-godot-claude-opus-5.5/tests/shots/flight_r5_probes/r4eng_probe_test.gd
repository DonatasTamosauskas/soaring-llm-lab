# 1. ViewTurn: limits and conservation under random owes
func test_r4_viewturn_fuzz_limits_and_conservation() -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = 404
	var vt := ViewTurn.new()
	var owed := 0.0
	var paid := 0.0
	var prev_rate := 0.0
	var st := {"rate": 0.0, "acc": 0.0, "cons": 0.0, "owes": 0, "active": 0}
	for i in 40000:
		if rng.randf() < 0.02:
			var d := rng.randf_range(-PI, PI) * (1.0 if rng.randf() < 0.5 else 0.03)
			vt.owe(d)
			owed += d
			st["owes"] += 1
		var x := vt.step(DT)
		paid += x
		var r := x / DT
		st["rate"] = maxf(st["rate"], absf(r))
		st["acc"] = maxf(st["acc"], absf(r - prev_rate) / DT)
		prev_rate = r
		if vt.active():
			st["active"] += 1
		st["cons"] = maxf(st["cons"], absf(wrapf(owed - paid - vt.debt, -PI, PI)))
	_log("[viewturn fuzz] %d owes, active %.0f %% of ticks: peak rate %.1f deg/s, peak accel %.1f deg/s^2 (tick finite differences), conservation error %.9f rad" % [
		st["owes"], 100.0 * st["active"] / 40000.0, rad_to_deg(st["rate"]), rad_to_deg(st["acc"]), st["cons"]])
	lt(rad_to_deg(st["rate"]), 120.0 * 1.02, "ViewTurn payout rate stays inside 120 deg/s under random owes")
	lt(rad_to_deg(st["acc"]), 240.0 * 1.10, "ViewTurn payout acceleration stays inside 240 deg/s^2 under random owes")
	lt(st["cons"], 1e-6, "ViewTurn loses nothing: owed = paid + debt (mod 2 pi)")
	metric("viewturn_fuzz", {"peak_rate": rad_to_deg(st["rate"]), "peak_acc": rad_to_deg(st["acc"]), "cons": st["cons"]})


