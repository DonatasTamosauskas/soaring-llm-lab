# 5. A stun in the middle of a hard turn
func test_r4_stun_mid_turn() -> void:
	for sp: StringName in [&"sparrow", &"pigeon", &"eagle"]:
		fx = FX.new(self)
		await fx.setup(sp, func(w: Variant) -> void:
			w.with_ground = false
			w.add_wall(Vector3(0, 100, -30.5), Vector3(200, 80, 1.0)))
		var p := fx.player
		var pr := p.model.params
		# Heading straight at the wall; full right roll 0.7 s before the
		# expected impact, so the bird hits while rolling into a hard turn.
		var v := pr.v_c
		var z0 := -30.0 + pr.r_body + v * 1.1
		p.start_flying(Vector3(0, 100, z0), 0.0, 0.0)
		p.model.reset(Vector3(0, 100, z0), Vector3(0, 0, -v), 0.0)
		var cal := p.wing_input.calibration
		fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
			b.set_airplane()
			if t > 0.4:
				b.synth(0.0, 1.0, 1.0, cal)
			b.humanize(DT)
		p.rig_limited_ticks = 0
		fx.reset_comfort()
		var st := {"stuns": 0, "prev": p.mode, "rate_at_hit": 0.0, "end": -1.0, "gap": -1.0}
		fx.on_tick = func(tick: int, f: Variant) -> void:
			var pl: PlayerBird = f.player
			var t := tick * DT
			if pl.mode == PlayerBird.Mode.STUNNED and st["prev"] != PlayerBird.Mode.STUNNED:
				st["stuns"] += 1
				if st["stuns"] == 1:
					st["rate_at_hit"] = pl.rig_yaw_rate
			if pl.mode == PlayerBird.Mode.FLYING and st["prev"] == PlayerBird.Mode.STUNNED and st["end"] < 0.0:
				st["end"] = t
			st["prev"] = pl.mode
		fx.run(6.0)
		var tag := "%s stun mid-turn" % sp
		_log("[stun mid-turn] %s: %d stun(s), rig rate at the hit %.0f deg/s, rig safety net %d ticks, peak rig rate %.1f deg/s, accel %.1f deg/s^2, mode %s" % [
			sp, st["stuns"], rad_to_deg(st["rate_at_hit"]), p.rig_limited_ticks,
			rad_to_deg(fx.comfort["max_rate"]), rad_to_deg(fx.comfort["max_accel"]), p.mode_name()])
		fx.assert_comfort(self, tag)
		lt(float(p.rig_limited_ticks) / maxf(1.0, fx.comfort["checked"]), 0.02, "%s: the comfort safety net acts on < 2%% of ticks" % tag)
		metric(tag, {"stuns": st["stuns"], "net": p.rig_limited_ticks, "rate_at_hit": rad_to_deg(st["rate_at_hit"])})
		fx.teardown()
		fx = null


