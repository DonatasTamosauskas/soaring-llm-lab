			i + 1, acc["roll"] / n, acc["by"] / n, acc["dpsi"] / n, acc["phi"] / n, acc["pl"] / n, acc["pr"] / n, acc["fdx"] / n, wrapf(chi - chi_prev, -180.0, 180.0)])
