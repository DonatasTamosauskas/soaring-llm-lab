	var secs := 9.0
	for sp in [&"sparrow", &"pigeon", &"eagle"]:
		for stroke in [[1.0, 45.0], [2.0, 45.0]]:
			var base := await _gaze_flap(sp, 0.0, 0.0, stroke[0], stroke[1], secs)
