## The fixture's setup, but in the wind world (FX.setup hard-codes its world).
func _setup_wind(sp: StringName, world_setup: Callable = Callable()) -> FX:
	fx = FX.new(self)
	var w := WW.new()
	if world_setup.is_valid():
		world_setup.call(w)
	fx.world = w
	add_child(w)
	fx.body = HumanPoseModel.new(1)
	var f := fx
	f.driver = func(_tick: int, _t: float, b: HumanPoseModel) -> void:
		b.set_airplane()
	f.src = ScriptedPoseSource.new(f.body, func(tick: int, t: float, b: HumanPoseModel) -> void:
		f.driver.call(tick, t, b))
	f.player = PLAYER.instantiate() as PlayerBird
	f.player.auto_process = false
	f.player.use_settings = false
	f.player.drive_world_scale = true
	f.player.default_source = &"none"
	f.player.mass = FlightParams.species_mass(sp)
	add_child(f.player)
	f.player.auto_calibrate = false
	f.player.set_pose_source(f.src)
	f._connect()
	await get_tree().physics_frame
	await get_tree().physics_frame
	return fx


func _ground(sp: StringName) -> void:
	fx = FX.new(self)
	await fx.setup(sp)
	var p := fx.player
	var vmin := p.model.params.v_min
	var start := Vector3(0, p.model.params.r_body + 0.25, 0)
	p.start_flying(start, 0.0, 0.0)
	p.model.reset(start, Vector3(0, -0.2 * vmin, -0.6 * vmin), 0.0)
	fx.run(1.5)


# --------------------------------------------------------------------------
# 1. Ground take-off at every size
func test_r3_ground_takeoff_every_size() -> void:
	var sizes := [&"sparrow", &"starling", &"pigeon", &"crow", &"gull", &"hawk", &"eagle"]
	# Two natural strategies a player tries: steady strokes with flat wrists,
	# and faster strokes with the leading edge pitched down 15 deg (push
	# forward to build speed). Either one leaving the ground counts.
	var strategies := [[1.0, 0.0, "1.0 Hz flat"], [1.3, -15.0, "1.3 Hz pitched fwd 15"]]
	for sp in sizes:
		var best_end := -INF
		var summary := PackedStringArray()
		for s in strategies:
			await _ground(sp)
			var p := fx.player
			var span := p.model.params.span
			var landed := p.mode == PlayerBird.Mode.GROUNDED
			if not landed:
				_log("%s: touchdown did not land (mode %s)" % [sp, p.mode_name()])
			var hz: float = s[0]
			var tw: float = float(s[1]) * DEG
			fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
				b.set_airplane()
				ScriptedPoseSource.flap(b, t + 0.5, 45.0, hz)
				for a in b.arms:
					a.twist = tw
			var st := {"regrounded": 0, "t_fly": -1.0, "max_agl": 0.0, "stuns": 0, "prev": p.mode}
			var t0 := fx.ticks
			fx.reset_events()
			fx.on_tick = func(tick: int, f: Variant) -> void:
				var pl: PlayerBird = f.player
				if st["t_fly"] < 0.0 and pl.mode == PlayerBird.Mode.FLYING:
					st["t_fly"] = (tick - t0) * DT
				if pl.mode == PlayerBird.Mode.GROUNDED and st["prev"] != PlayerBird.Mode.GROUNDED:
					st["regrounded"] += 1
				if pl.mode == PlayerBird.Mode.STUNNED and st["prev"] != PlayerBird.Mode.STUNNED:
					st["stuns"] += 1
				st["prev"] = pl.mode
				st["max_agl"] = maxf(st["max_agl"], pl.model.position.y - pl.model.params.r_body)
			fx.run(12.0)
			var agl_end := p.model.position.y - p.model.params.r_body
			var ok := p.mode == PlayerBird.Mode.FLYING and agl_end >= 2.0 * span
			best_end = maxf(best_end, agl_end / span if p.mode == PlayerBird.Mode.FLYING else -1.0)
			summary.append("%s: t_fly %.2f s, re-grounded %d, stuns %d, max AGL %.1f spans, end AGL %.1f spans, end mode %s, V %.1f m/s (%s)" % [
				s[2], st["t_fly"], st["regrounded"], st["stuns"], float(st["max_agl"]) / span, agl_end / span, p.mode_name(),
				p.model.airspeed(), "OK" if ok else "STUCK"])
			fx.assert_comfort(self, "%s ground take-off %s" % [sp, s[2]])
			fx.teardown()
			fx = null
		_log("[ground take-off] %s | %s" % [sp, " | ".join(summary)])
		metric("ground_takeoff_best_end_agl_spans_%s" % sp, best_end)
		gt(best_end, 2.0, "%s: a grounded player who flaps (either strategy, 12 s) is FLYING >= 2 spans above the ground" % sp)


