# 5. Perching in the breeze
func test_r3_perch_in_breeze() -> void:
	var perch_at := Vector3(0, 20, -10)
	var winds := [[Vector3(0, 0, 2.64), "headwind"], [Vector3(2.64, 0, 0), "crosswind"], [Vector3(0, 0, -2.64), "tailwind"]]
	for sp in [&"sparrow", &"pigeon", &"eagle"]:
		for wd in winds:
			await _setup_wind(sp, func(w: Variant) -> void:
				w.add_perch(perch_at, Vector3.FORWARD, 10.0, 0.015, 1.0)
				w.uniform_wind = wd[0])
			var p := fx.player
			var pr := p.model.params
			var vcap := 0.8 * pr.v_min
			var target := perch_at + Vector3.UP * pr.r_body
			var start := target + Vector3(0, 0.3 * pr.span, 6.0 * pr.span)
			p.start_flying(start, 0.0, 0.0)
			# A slow, player-like approach: airspeed 1.2 V_cap straight at the
			# perch (in the air mass), wrists slightly up to keep it slow.
			p.model.reset(start, Vector3(0, 0, -1.2 * vcap) + (wd[0] as Vector3), 0.0)
			fx.driver = fx.synth(0.3, 0.0, 1.0)
			var st := {"t": -1.0}
			fx.reset_events()
			fx.on_tick = func(tick: int, f: Variant) -> void:
				if st["t"] < 0.0 and f.player.mode == PlayerBird.Mode.PERCHED:
					st["t"] = tick * DT
			var t0 := fx.ticks
			fx.run(8.0)
			var t_p: float = float(st["t"]) - t0 * DT if float(st["t"]) >= 0.0 else -1.0
			_log("[perch in wind] %s %s 2.64 m/s (V_cap %.2f m/s): perched %s at %.2f s, collisions %d, end mode %s" % [
				sp, wd[1], vcap, str(t_p >= 0.0), t_p, fx.events["collided"], p.mode_name()])
			metric("perch_wind_%s_%s" % [sp, wd[1]], t_p)
			if wd[1] != "tailwind":
				check(t_p >= 0.0, "%s: a slow approach in a 2.64 m/s %s perches within 8 s" % [sp, wd[1]])
			fx.assert_comfort(self, "%s perch %s" % [sp, wd[1]])
			fx.teardown()
			fx = null


