# 3. V_max tucked dive into flat ground
func test_r3_vmax_dive_into_ground() -> void:
	for sp in [&"sparrow", &"pigeon", &"eagle"]:
		for ang: float in [90.0, 60.0]:
			fx = FX.new(self)
			await fx.setup(sp)
			var p := fx.player
			var pr := p.model.params
			# Arms spread first (WingInput's never-spread floor), then a real
			# tuck: hands to the chest, nose down (zero lift), at 0.97 V_max.
			p.start_flying(Vector3(0, 300, 0), 0.0, 0.0)
			fx.run(0.5)
			fx.driver = func(_tick: int, _t: float, b: HumanPoseModel) -> void:
				b.set_airplane()
				for a in b.arms:
					a.elbow = 150.0 * DEG
			fx.run(0.4)
			var v := 0.97 * pr.v_max
			var dir := Vector3(0, -sin(ang * DEG), -cos(ang * DEG))
			var start := Vector3(0, pr.r_body + v * 0.5 * sin(ang * DEG) + 0.01, 0)
			p.model.reset(start, dir * v, 0.0)
			p.model.theta = -ang * DEG
			var st := {"min_clear": INF, "stun_enter": 0, "prev": p.mode, "modes": [], "cam_min": INF, "nan": 0, "tucked": p.wing_state().tucked}
			fx.reset_events()
			fx.on_tick = func(_tick: int, f: Variant) -> void:
				var pl: PlayerBird = f.player
				st["min_clear"] = minf(st["min_clear"], pl.model.position.y - pl.model.params.r_body)
				st["cam_min"] = minf(st["cam_min"], pl.camera.global_position.y)
				if not pl.model.position.is_finite():
					st["nan"] += 1
				if pl.mode != st["prev"]:
					if pl.mode == PlayerBird.Mode.STUNNED:
						st["stun_enter"] += 1
					(st["modes"] as Array).append(pl.mode_name())
				st["prev"] = pl.mode
			fx.run(4.0)
			_log("[ground impact] %s %.0f deg tucked=%s at %.1f m/s: min clearance %.1f mm, camera min y %.3f m, stuns %d, collided events %d, modes %s, end mode %s" % [
				sp, ang, str(st["tucked"]), v, float(st["min_clear"]) * 1000.0, st["cam_min"], st["stun_enter"], fx.events["collided"],
				" -> ".join(PackedStringArray(st["modes"])), p.mode_name()])
			check(bool(st["tucked"]), "%s %.0f deg: the dive is tucked" % [sp, ang])
			gt(float(st["min_clear"]), -0.002, "%s %.0f deg: V_max into the ground never tunnels (body clears it)" % [sp, ang])
			eq(st["nan"], 0, "%s %.0f deg: finite" % [sp, ang])
			between(float(st["stun_enter"]), 1.0, 1.0, "%s %.0f deg: exactly one brief stun" % [sp, ang])
			# Arms spread and flapping after the crash: the bird can leave.
			fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
				b.set_airplane()
				ScriptedPoseSource.flap(b, t + 0.5, 45.0, 1.3)
				for a in b.arms:
					a.twist = -15.0 * DEG
			fx.run(10.0)
			var agl := p.model.position.y - pr.r_body
			_log("[ground impact] %s %.0f deg: after 10 s of flapping mode %s, AGL %.1f spans" % [sp, ang, p.mode_name(), agl / pr.span])
			gt(agl / pr.span, 2.0, "%s %.0f deg: after the crash, flapping gets the bird >= 2 spans up" % [sp, ang])
			metric("impact_%s_%d" % [sp, int(ang)], {"min_clear_mm": float(st["min_clear"]) * 1000.0, "stuns": st["stun_enter"], "agl_after_spans": agl / pr.span})
			fx.assert_comfort(self, "%s ground impact %.0f" % [sp, ang])
			fx.teardown()
			fx = null


