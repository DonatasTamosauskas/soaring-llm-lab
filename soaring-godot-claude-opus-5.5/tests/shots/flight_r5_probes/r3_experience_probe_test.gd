# 4. The world's breeze: neutral arms never rotate the view
func test_r3_breeze_neutral_glide() -> void:
	for sp in [&"sparrow", &"pigeon", &"eagle"]:
		for hdg: float in [0.0, 90.0, 180.0, 270.0]:
			await _setup_wind(sp, func(w: Variant) -> void:
				w.breeze_on = true)
			var p := fx.player
			var w: Variant = fx.world
			p.start_flying(Vector3(0, 400, 0), hdg * DEG, 0.0)
			# Start in the moving air mass (no initial gust).
			p.model.velocity += w.breeze_at(p.model.position)
			var st := {"rate": 0.0, "acc": 0.0, "bank": 0.0, "h0": 0.0, "slip": 0.0}
			fx.on_tick = func(tick: int, f: Variant) -> void:
				f.world.clock += DT
				var pl: PlayerBird = f.player
				if tick * DT < 3.0:
					st["h0"] = pl.model.heading()
					return
				st["rate"] = maxf(st["rate"], absf(pl.rig_yaw_rate))
				st["acc"] = maxf(st["acc"], absf(pl.rig_yaw_accel))
				st["bank"] = maxf(st["bank"], absf(pl.model.phi))
			fx.run(40.0)
			var dh := rad_to_deg(absf(FlightMath.wrap_angle(p.model.heading() - float(st["h0"]))))
			_log("[breeze glide] %s heading %3.0f: rig yaw rate max %.2f deg/s, accel max %.1f deg/s2, bank max %.2f deg, heading drift %.2f deg in 37 s" % [
				sp, hdg, rad_to_deg(st["rate"]), rad_to_deg(st["acc"]), rad_to_deg(st["bank"]), dh])
			lt(rad_to_deg(st["rate"]), 3.0, "%s hdg %.0f: neutral arms in the world breeze, the view yaws < 3 deg/s" % [sp, hdg])
			lt(rad_to_deg(st["bank"]), 5.0, "%s hdg %.0f: neutral arms in the breeze, bank < 5 deg" % [sp, hdg])
			lt(dh, 10.0, "%s hdg %.0f: neutral arms in the breeze, heading drifts < 10 deg in 37 s" % [sp, hdg])
			fx.assert_comfort(self, "%s breeze %.0f" % [sp, hdg])
			fx.teardown()
			fx = null


## A crosswind gust front (2.6 m/s from the side, ramped over 0.5 s): the
## view may turn with the bird, inside the caps, and settle.
func test_r3_crosswind_gust_front() -> void:
	for sp in [&"sparrow", &"pigeon", &"eagle"]:
		await _setup_wind(sp, func(w: Variant) -> void:
			w.step_wind = Vector3(2.64, 0, 0)
			w.step_t0 = 3.0
			w.step_ramp = 0.5)
		var p := fx.player
		p.start_flying(Vector3(0, 400, 0), 0.0, 0.0)
		var st := {"rate": 0.0, "acc": 0.0, "bank": 0.0, "h0": 0.0, "h_set": 0.0}
		fx.on_tick = func(tick: int, f: Variant) -> void:
			f.world.clock += DT
			var pl: PlayerBird = f.player
			if tick * DT < 3.0:
				st["h0"] = pl.model.heading()
				return
			st["rate"] = maxf(st["rate"], absf(pl.rig_yaw_rate))
			st["acc"] = maxf(st["acc"], absf(pl.rig_yaw_accel))
			st["bank"] = maxf(st["bank"], absf(pl.model.phi))
			if tick * DT > 12.0:
				st["h_set"] = maxf(st["h_set"], absf(pl.rig_yaw_rate))
		fx.run(15.0)
		var dh := rad_to_deg(FlightMath.wrap_angle(p.model.heading() - float(st["h0"])))
		_log("[gust front] %s 2.64 m/s cross over 0.5 s: rig yaw rate max %.1f deg/s, accel max %.0f deg/s2, bank max %.1f deg, heading change %.1f deg, yaw rate after 9 s %.2f deg/s" % [
			sp, rad_to_deg(st["rate"]), rad_to_deg(st["acc"]), rad_to_deg(st["bank"]), dh, rad_to_deg(st["h_set"])])
		lt(rad_to_deg(st["h_set"]), 1.0, "%s: the gust front's turn settles (< 1 deg/s after 9 s)" % sp)
		fx.assert_comfort(self, "%s gust front" % sp)
		fx.teardown()
		fx = null


