# 2. Sustained flapping for 60 s
func test_r3_sustained_flapping_60s() -> void:
	for sp in [&"sparrow", &"pigeon", &"eagle"]:
		for mode in [[1.0, 40.0, "steady 1 Hz 40 deg"], [2.0, 45.0, "frantic 2 Hz 45 deg"]]:
			fx = FX.new(self)
			await fx.setup(sp)
			var p := fx.player
			p.start_flying(Vector3(0, 150, 0), 0.0, 0.0)
			var hz: float = mode[0]
			var amp: float = mode[1]
			fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
				b.set_airplane()
				ScriptedPoseSource.flap(b, t, amp, hz)
			var alt := PackedFloat64Array()
			var st := {"end_min": 1.0, "stalls": 0}
			fx.on_tick = func(tick: int, f: Variant) -> void:
				var pl: PlayerBird = f.player
				st["end_min"] = minf(st["end_min"], minf(pl.model.endurance_l, pl.model.endurance_r))
				if tick % 72 == 0:
					alt.append(pl.model.position.y)
			fx.reset_events()
			fx.run(60.0)
			var y0 := 150.0
			# alt[i] is the altitude at (i + 1) s.
			var seg := [(alt[19] - y0) / 20.0, (alt[39] - alt[19]) / 20.0, (alt[59] - alt[39]) / 20.0]
			_log("[60 s flapping] %s %s: climb per 20 s segment %.2f / %.2f / %.2f m/s, endurance min %.2f, stalls %d, V end %.1f m/s (%.2f V_c)" % [
				sp, mode[2], seg[0], seg[1], seg[2], st["end_min"], fx.events["stalled"], p.model.airspeed(),
				p.model.airspeed() / p.model.params.v_c])
			metric("flap60_%s_%s" % [sp, String(mode[2]).replace(" ", "_")], seg)
			if hz == 1.0:
				gt(float(seg[2]), 0.0, "%s %s: still climbing in the last 20 s of a minute of steady strokes" % [sp, mode[2]])
				gt((float(alt[alt.size() - 1]) - y0) / 60.0, 0.2, "%s %s: net climb over 60 s > 0.2 m/s" % [sp, mode[2]])
			fx.assert_comfort(self, "%s 60 s %s" % [sp, mode[2]])
			fx.teardown()
			fx = null


