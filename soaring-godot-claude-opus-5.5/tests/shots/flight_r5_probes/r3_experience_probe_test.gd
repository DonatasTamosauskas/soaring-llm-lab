# 6. The forced stun turn-away: how much view rotation the player gets
func test_r3_stun_turn_away_view_rotation() -> void:
	for sp in [&"sparrow", &"pigeon", &"eagle"]:
		for inc: float in [90.0, 60.0, 40.0]:
			fx = FX.new(self)
			await fx.setup(sp, func(w: Variant) -> void:
				w.with_ground = false
				w.add_wall(Vector3(0, 100, -20), Vector3(200, 60, 1.0)))
			var p := fx.player
			var pr := p.model.params
			# Approach the wall (normal +Z) at incidence `inc` to its surface.
			var yaw := (90.0 - inc) * DEG
			var start := Vector3(0, 100, -20 + 0.5 + pr.r_body + pr.v_c * 0.8 * sin(inc * DEG))
			start.x += pr.v_c * 0.8 * cos(inc * DEG)
			p.start_flying(start, yaw, 0.0)
			var st := {"stun_t": -1.0, "yaw0": 0.0, "rot": 0.0, "rate": 0.0, "stuns": 0, "prev": p.mode, "kinds": {}}
			fx.reset_events()
			fx.on_tick = func(tick: int, f: Variant) -> void:
				var pl: PlayerBird = f.player
				if pl.mode == PlayerBird.Mode.STUNNED and st["prev"] != PlayerBird.Mode.STUNNED:
					st["stuns"] += 1
					if st["stun_t"] < 0.0:
						st["stun_t"] = tick * DT
						st["yaw0"] = pl.rig_yaw
				st["prev"] = pl.mode
				if st["stun_t"] >= 0.0 and tick * DT - float(st["stun_t"]) <= 2.5:
					st["rot"] = maxf(st["rot"], absf(FlightMath.wrap_angle(pl.rig_yaw - float(st["yaw0"]))))
					st["rate"] = maxf(st["rate"], absf(pl.rig_yaw_rate))
			fx.run(3.0)
			_log("[stun turn-away] %s incidence %2.0f deg at cruise: stuns %d, slides %d, forced view rotation %.0f deg within 2.5 s, peak %.0f deg/s" % [
				sp, inc, st["stuns"], p.contacts["slide"], rad_to_deg(st["rot"]), rad_to_deg(st["rate"])])
			metric("turnaway_%s_%d" % [sp, int(inc)], [st["stuns"], rad_to_deg(st["rot"]), rad_to_deg(st["rate"])])
			fx.assert_comfort(self, "%s wall %.0f" % [sp, inc])
			fx.teardown()
			fx = null
