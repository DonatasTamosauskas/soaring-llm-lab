# --- 8c. Ground landing quality (asserted) ----------------------------------------------------
## (a) PB-11's own slow shallow touchdown (0.6 V_min forward, 0.2 V_min down):
##     the view's per-tick velocity change through the landing, against the
##     area's own P9 bound for perch captures (<= 0.45 x the approach speed;
##     round 1's one-tick stop was 1.0).
## (b) A bird below V_min with its belly on the grass is not still "flying"
##     2 s later (a skimming bird below stall speed has no lift to fly on).
## (c) A full flare (wrists +40 deg) begun 0.3 - 2 spans above flat ground
##     lands without a stun.
func test_r5x_ground_landing_quality() -> void:
	for sp in S3:
		await _new_fx(sp)
		var p := fx.player
		var pr := p.model.params
		var start := Vector3(0, pr.r_body + 0.25, 0)
		p.start_flying(start, 0.0, 0.0)
		var v0 := Vector3(0, -0.2 * pr.v_min, -0.6 * pr.v_min)
		p.model.reset(start, v0, 0.0)
		var st := {"last": p.camera.global_position, "lastv": v0, "worst": 0.0, "n": 0}
		fx.on_tick = func(_i: int, f: Variant) -> void:
			var pl: PlayerBird = f.player
			var c := pl.camera.global_position
			var v: Vector3 = (c - st["last"]) / DT
			if int(st["n"]) > 0:
				st["worst"] = maxf(st["worst"], (v - st["lastv"]).length())
			st["n"] += 1
			st["last"] = c
			st["lastv"] = v
		fx.run(1.5)
		var ratio := float(st["worst"]) / v0.length()
		_log("%s ground touchdown (PB-11 setup, %.2f m/s): mode %s, worst per-tick view velocity change %.2f m/s = %.2f x the touchdown speed (%.1f m/s perceived)" % [
			sp, v0.length(), p.mode_name(), st["worst"], ratio, float(st["worst"]) / maxf(p.origin.world_scale, 1e-4)])
		eq(p.mode, PlayerBird.Mode.GROUNDED, "%s: the slow touchdown lands" % sp)
		lt(ratio, 0.45, "%s: a ground landing eases in like a perch capture (P9 bound 0.45 x)" % sp)
		await _done()
	for sp in S3:
		var r: Dictionary = await _ground_trace(sp, 0.0, 60.0)
		# re-run with the belly/speed monitor
		await _new_fx(sp)
		var p := fx.player
		var pr := p.model.params
		p.start_flying(Vector3(0, 6.0 * pr.span + 2.0, 0), 0.0, 0.0)
		var st := {"slow_skim": 0.0, "worst": 0.0}
		fx.on_tick = func(_i: int, f: Variant) -> void:
			var pl: PlayerBird = f.player
			var belly: float = pl.model.position.y - pl.model.params.r_body
			if pl.mode == PlayerBird.Mode.FLYING and belly < 0.02 and pl.model.airspeed() < pl.model.params.v_min:
				st["slow_skim"] += DT
				st["worst"] = maxf(st["worst"], st["slow_skim"])
			else:
				st["slow_skim"] = 0.0
		fx.run(60.0)
		_log("%s neutral glide into flat ground: grounded at %.1f s; longest stretch FLYING on the grass below V_min %.1f s" % [sp, r["ground_t"], st["worst"]])
		lt(float(st["worst"]), 2.0, "%s: never 'flies' along the grass below V_min for more than 2 s" % sp)
		between(float(r["ground_t"]), 0.0, 20.0, "%s: a neutral glide into a meadow comes to rest within 20 s" % sp)
		await _done()
	for sp in S3:
		for fh in [0.3, 1.0, 2.0]:
			var r: Dictionary = await _ground_trace(sp, 40.0, 25.0, fh)
			eq(r["stuns"], 0, "%s: a full flare begun %.1f spans up lands without a stun" % [sp, fh])
			check(float(r["ground_t"]) > 0.0, "%s: the flare from %.1f spans lands" % [sp, fh])


