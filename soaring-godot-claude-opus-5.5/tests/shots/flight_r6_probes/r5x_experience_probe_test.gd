# --- 1. Pause menu mid-flight --------------------------------------------------------

func test_r5x_resume_from_pause_menu_pose() -> void:
	for sp in S3:
		await _new_fx(sp)
		var p := fx.player
		p.start_flying(Vector3(0, 120, 0), 0.0, 0.0)
		# phase: 0 = airplane arms; 1 = resumed in the menu pose, easing back
		var st := {"phase": 0, "t_res": 0.0}
		fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
			b.set_airplane()
			if st["phase"] == 1:
				# 0.8 s from the menu pose back to the airplane pose.
				var k := clampf((t - float(st["t_res"])) / 0.8, 0.0, 1.0)
				var e := k * k * (3.0 - 2.0 * k)
				b.arms[0].dihedral = lerpf(-80.0 * DEG, 0.0, e)
				b.arms[1].dihedral = lerpf(35.0 * DEG, 0.0, e)
				b.arms[1].sweep = lerpf(60.0 * DEG, 0.0, e)
				b.arms[1].elbow = lerpf(20.0 * DEG, 0.0, e)
				b.head_yaw = lerpf(20.0 * DEG, 0.0, e)
				b.room_offset = Vector3(0.3, 0.0, -0.4)
		fx.run(2.0)
		var hdg0 := p.model.heading()
		var y0 := p.model.position.y
		# The pause: no flight ticks. The engine's unpause notification.
		st["phase"] = 1
		st["t_res"] = fx.src.tick * DT
		p.notification(Node.NOTIFICATION_UNPAUSED)
		fx.reset_events()
		var mx := {"bank": 0.0, "flapf": 0.0, "rate": 0.0}
		fx.on_tick = func(_i: int, f: Variant) -> void:
			var pl: PlayerBird = f.player
			mx["bank"] = maxf(mx["bank"], absf(pl.model.phi))
			mx["flapf"] = maxf(mx["flapf"], absf(pl.model.flap_n))
			mx["rate"] = maxf(mx["rate"], absf(pl.rig_yaw_rate))
		fx.run(3.0)
		var dh := rad_to_deg(FlightMath.wrap_angle(p.model.heading() - hdg0))
		var dy := p.model.position.y - y0
		_log("%s resume-from-menu: flap events %d, max flap force %.3f N (weight %.3f N), max bank %.1f deg, heading change %.1f deg, rig rate max %.0f deg/s, dy %.2f m (3 s)" % [
			sp, fx.events["flapped"], mx["flapf"], p.mass * 9.81, rad_to_deg(mx["bank"]), dh, rad_to_deg(mx["rate"]), dy])
		eq(fx.events["flapped"], 0, "%s: resuming from the pause pose invents no wingbeat" % sp)
		lt(mx["flapf"], 0.05 * p.mass * 9.81, "%s: no flap force from the resume jump (N)" % sp)
		fx.assert_comfort(self, "%s resume" % sp)
		await _done()


# --- 2. Growth mid-flight (GameLoop's meal steps) --------------------------------------

func test_r5x_growth_meals_in_flight() -> void:
	await _new_fx(&"sparrow")
	var p := fx.player
	p.start_flying(Vector3(0, 150, 0), 0.0, 0.0)
	fx.run(1.0)
	var hdg0 := p.model.heading()
	var rig0 := p.rig_yaw
	fx.reset_events()
	var mx := {"cam_step": 0.0, "ws_rate": 0.0, "last_cam": p.camera.global_position,
		"last_body": p.model.position, "last_ws": p.origin.world_scale, "modes": {}}
	fx.on_tick = func(_i: int, f: Variant) -> void:
		var pl: PlayerBird = f.player
		var cam := pl.camera.global_position
		var d_cam: Vector3 = cam - mx["last_cam"]
		var d_body: Vector3 = pl.model.position - mx["last_body"]
		mx["cam_step"] = maxf(mx["cam_step"], (d_cam - d_body).length() / maxf(pl.origin.world_scale, 1e-4))
		mx["ws_rate"] = maxf(mx["ws_rate"], absf(log(pl.origin.world_scale / float(mx["last_ws"]))) / DT)
		mx["last_cam"] = cam
		mx["last_body"] = pl.model.position
		mx["last_ws"] = pl.origin.world_scale
		mx["modes"][pl.mode_name()] = true
	# Six meals, 1 s apart, +25 % each (x3.8: sparrow 30 g -> ~114 g).
	for k in 6:
		p.mass = p.mass * 1.25
		fx.run(1.0)
	fx.run(6.0)
	var t := p.telemetry()
	var pr := p.model.params
	var hdg_dev := rad_to_deg(absf(FlightMath.wrap_angle(p.model.heading() - hdg0)))
	var rig_dev := rad_to_deg(absf(FlightMath.wrap_angle(p.rig_yaw - rig0)))
	_log("growth meals: mass %.3f kg species %s, stalls %d, modes %s, heading drift %.2f deg, rig yaw drift %.2f deg, airspeed %.2f (V_c %.2f, V_min %.2f), camera step off body %.4f m perceived/tick, ws %.3f target %.3f, max dln(ws)/dt %.3f /s, cam err %.5f m" % [
		p.mass, str(t["species"]), fx.events["stalled"], str(mx["modes"].keys()), hdg_dev, rig_dev, p.model.airspeed(), pr.v_c, pr.v_min,
		mx["cam_step"], p.origin.world_scale, p.world_scale_target, mx["ws_rate"], fx.comfort["camera_err"]])
	eq(fx.events["stalled"], 0, "growth: a meal never stalls the bird")
	check(not mx["modes"].has("stunned"), "growth: never stunned")
	eq(StringName(t["species"]), SizeRules.species_for_mass(p.mass), "growth: telemetry species follows the mass")
	lt(hdg_dev, 2.0, "growth: heading unchanged by growth (deg)")
	lt(rig_dev, 2.0, "growth: no view turn from growth (deg)")
	between(p.model.airspeed() / pr.v_c, 0.8, 1.25, "growth: settles near the NEW cruise speed (bigger = faster)")
	lt(mx["ws_rate"], p.tuning.world_scale_ramp + 1e-3, "growth: world_scale ramps at <= world_scale_ramp")
	fx.assert_comfort(self, "growth")
	await _done()
	# One big step (a tier jump, e.g. sparrow -> pigeon mass at once): report.
	await _new_fx(&"sparrow")
	p = fx.player
	p.start_flying(Vector3(0, 150, 0), 0.0, 0.0)
	fx.run(1.0)
	fx.reset_events()
	var y0 := p.model.position.y
	p.mass = FlightParams.species_mass(&"pigeon")
	var st := {"min_v": INF, "stalled_ticks": 0}
	fx.on_tick = func(_i: int, f: Variant) -> void:
		var pl: PlayerBird = f.player
		st["min_v"] = minf(st["min_v"], pl.model.airspeed() / pl.model.params.v_min)
		if pl.model.stalled:
			st["stalled_ticks"] += 1
	fx.run(8.0)
	_log("growth sparrow->pigeon in one step: stalls %d (stalled %.2f s), min V/V_min %.2f, dy %.1f m in 8 s, V/V_c end %.2f" % [
		fx.events["stalled"], st["stalled_ticks"] * DT, st["min_v"], p.model.position.y - y0, p.model.airspeed() / p.model.params.v_c])
	eq(fx.events["stalled"], 0, "big growth step: no stall")
	fx.assert_comfort(self, "growth step")


# --- 3. Stall through the wrists (default preset) ----------------------------------------

func test_r5x_wrist_stall_and_recovery() -> void:
	for sp in S3:
		for twist_deg in [45.0, 70.0]:
			await _new_fx(sp)
			var p := fx.player
			p.start_flying(Vector3(0, 300, 0), 0.0, 0.0)
			var tr: Dictionary = p.model.trim_solution(0.0)
			var st := {"stall_t": -1.0, "rel": 5.0, "unstall_t": -1.0, "restall": 0, "st_ticks": 0,
				"min_cl": INF, "max_alpha": 0.0, "was": false, "hold_events": 0}
			fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
				b.set_airplane()
				var k := 0.0
				if t >= 1.0 and t < 5.0:
					k = clampf((t - 1.0) / 0.2, 0.0, 1.0)
				elif t >= 5.0:
					k = clampf(1.0 - (t - 5.0) / 0.2, 0.0, 1.0)
				b.arms[0].twist = k * twist_deg * DEG
				b.arms[1].twist = k * twist_deg * DEG
			fx.reset_events()
			fx.on_tick = func(i: int, f: Variant) -> void:
				var pl: PlayerBird = f.player
				var tt := i * DT
				var s := pl.model.stalled
				st["max_alpha"] = maxf(st["max_alpha"], pl.model.alpha)
				if s:
					st["st_ticks"] += 1
				if s and st["stall_t"] < 0.0:
					st["stall_t"] = tt
				if not s and bool(st["was"]) and tt > 5.0 and st["unstall_t"] < 0.0:
					st["unstall_t"] = tt
				if s and not bool(st["was"]) and float(st["unstall_t"]) > 0.0:
					st["restall"] += 1
				st["was"] = s
			fx.run(5.0)
			var hold_events: int = fx.events["stalled"]
			fx.run(6.0)
			var t_rec := float(st["unstall_t"]) - 5.0 if float(st["unstall_t"]) > 0.0 else -1.0
			if not p.model.stalled and float(st["stall_t"]) < 0.0:
				t_rec = 0.0
			_log("%s wrists +%.0f deg held 4 s (default preset): first stall %.2f s after the hold began, stall events in hold %d, stalled %.2f s, max alpha %.1f deg (alpha_s %.1f), unstalled %.2f s after release, re-stalls %d, end V/V_trim %.2f" % [
				sp, twist_deg, float(st["stall_t"]) - 1.0 if float(st["stall_t"]) > 0.0 else -1.0, hold_events, st["st_ticks"] * DT,
				rad_to_deg(st["max_alpha"]), rad_to_deg(p.model.params.alpha_s), t_rec, st["restall"], p.model.airspeed() / float(tr["v"])])
			if twist_deg >= 45.0:
				check(float(st["stall_t"]) > 0.0, "%s: a %.0f deg nose-up wrist twist held 4 s stalls (DESIGN req 2)" % [sp, twist_deg])
			lt(hold_events, 4, "%s %.0f: at most 3 stall events in a 4 s hold (haptic cadence)" % [sp, twist_deg])
			check(not p.model.stalled, "%s %.0f: recovered 6 s after releasing the wrists" % [sp, twist_deg])
			eq(st["restall"], 0, "%s %.0f: no re-stall with neutral wrists" % [sp, twist_deg])
			await _done()


# --- 4. Ledge perch with a wall behind -------------------------------------------------

const LEDGE_Y := 20.0
const WALL_Z := -12.0

func _ledge_world(sp_span: float, with_wall: bool) -> Callable:
	return func(w: Variant) -> void:
		var depth := maxf(0.6 * sp_span, 0.15)
		if with_wall:
			w.add_wall(Vector3(0, LEDGE_Y, WALL_Z - 0.25), Vector3(40, 40, 0.5))
			# The ledge: a slab sticking out of the wall, its top at LEDGE_Y.
			w.add_wall(Vector3(0, LEDGE_Y - 0.05, WALL_Z + depth * 0.5), Vector3(4.0 * sp_span + 1.0, 0.1, depth))
			var pr: Perch = w.add_virtual_perch(Vector3(0, LEDGE_Y, WALL_Z + depth * 0.5), Vector3.BACK)
			pr.kind = Perch.Kind.LEDGE
		else:
			w.add_perch(Vector3(0, LEDGE_Y, WALL_Z + depth * 0.5), Vector3.BACK, 10.0, 0.02, 1.0)


func test_r5x_ledge_perch_with_a_wall_behind() -> void:
	for sp in S3:
		var span := SizeRules.wingspan_for_mass(FlightParams.species_mass(sp))
		for wall in [false, true]:
			for back_spans in [10.0, 16.0]:
				await _new_fx(sp, _ledge_world(span, wall))
				var p := fx.player
				var pr := p.model.params
				var depth := maxf(0.6 * pr.span, 0.15)
				var grip := Vector3(0, LEDGE_Y, WALL_Z + depth * 0.5)
				var start := grip + Vector3(0, pr.r_body + 0.4 * pr.span, back_spans * pr.span)
				# A player slowing down for the ledge: wrists 33 deg up (pitch
				# ~0.7, below the assist's 1.6 V_cap), arms spread.
				p.start_flying(start, 0.0, 0.7)
				fx.driver = func(_tick: int, _t: float, b: HumanPoseModel) -> void:
					b.set_airplane()
					b.arms[0].twist = 33.0 * DEG
					b.arms[1].twist = 33.0 * DEG
				fx.reset_events()
				var st := {"perch_t": -1.0}
				fx.on_tick = func(i: int, f: Variant) -> void:
					if st["perch_t"] < 0.0 and f.player.mode == PlayerBird.Mode.PERCHED:
						st["perch_t"] = i * DT
				fx.run(8.0)
				var ok := p.mode == PlayerBird.Mode.PERCHED and p.perch != null
				_log("%s %s from %.0f spans (%.1f m) at V %.2f V_min: perched %s at %.2f s, stuns %d, slides %d, final mode %s, final pos %s" % [
					sp, "LEDGE+WALL" if wall else "free branch", back_spans, back_spans * pr.span, p.model.airspeed() / pr.v_min if not ok else 0.0,
					str(ok), st["perch_t"], p.contacts["stun"], p.contacts["slide"], p.mode_name(), str(p.model.position.snapped(Vector3.ONE * 0.01))])
				eq(p.contacts["stun"], 0, "%s %s %.0f spans: a slow ledge approach never stuns" % [sp, "ledge" if wall else "branch", back_spans])
				check(ok, "%s %s %.0f spans: slow approach perches" % [sp, "ledge" if wall else "branch", back_spans])
				await _done()


# --- 5. Coordinated turn from the arms (arm dihedral) -------------------------------------

func test_r5x_arm_dihedral_turn_is_coordinated() -> void:
	for sp in S3:
		await _new_fx(sp)
		var p := fx.player
		p.start_flying(Vector3(0, 300, 0), 0.0, 0.0)
		# Left hand up 15 deg, right hand down 15 deg: "airplane arms" bank right.
		fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
			b.set_airplane()
			var k := clampf((t - 0.5) / 0.4, 0.0, 1.0)
			b.arms[0].dihedral = k * 15.0 * DEG
			b.arms[1].dihedral = -k * 15.0 * DEG
		var acc := {"n": 0, "ratio": 0.0, "worst": 0.0, "slip": 0.0, "bank": 0.0}
		var prev := {"h": p.model.heading()}
		fx.on_tick = func(i: int, f: Variant) -> void:
			var pl: PlayerBird = f.player
			var h := pl.model.heading()
			var rate := FlightMath.wrap_angle(h - float(prev["h"])) / DT
			prev["h"] = h
			if i * DT < 4.0:
				return
			var v := pl.model.airspeed()
			var ideal := 9.81 * tan(pl.model.phi) / maxf(v, 0.1)
			if absf(ideal) > 1e-3:
				var r := -rate / ideal
				acc["ratio"] += r
				acc["n"] += 1
				acc["worst"] = maxf(acc["worst"], absf(r - 1.0))
			acc["slip"] = maxf(acc["slip"], absf(pl.model.dpsi))
			acc["bank"] = pl.model.phi
		fx.run(9.0)
		var mean := float(acc["ratio"]) / maxi(int(acc["n"]), 1)
		_log("%s arm dihedral +-15 deg: bank %.1f deg, heading rate / (g tan(bank)/V) mean %.3f worst dev %.3f, max sideslip %.2f deg" % [
			sp, rad_to_deg(acc["bank"]), mean, acc["worst"], rad_to_deg(acc["slip"])])
		gt(rad_to_deg(acc["bank"]), 5.0, "%s: arm dihedral banks right (deg)" % sp)
		between(mean, 0.8, 1.2, "%s: coordinated from the arms (F4 within 20 %%)" % sp)
		lt(rad_to_deg(acc["slip"]), 5.0, "%s: sideslip < 5 deg from the arms" % sp)
		fx.assert_comfort(self, "%s dihedral turn" % sp)
		await _done()


# --- 6. Updraft through the pose chain -------------------------------------------------------

func test_r5x_updraft_through_the_pose_chain() -> void:
	for sp in S3:
		await _new_fx(sp, func(w: Variant) -> void: w.uniform_wind = Vector3(0, 3.0, 0))
		var p := fx.player
		p.start_flying(Vector3(0, 100, 0), 0.0, 0.0)
		fx.run(2.0)
		fx.reset_events()
		var y0 := p.model.position.y
		fx.run(10.0)
		var climb := (p.model.position.y - y0) / 10.0
		_log("%s 3 m/s updraft, arms spread and still: climb %+.2f m/s, flap events %d, in_updraft %.2f" % [
			sp, climb, fx.events["flapped"], float(p.telemetry()["in_updraft"])])
		gt(climb, 1.0, "%s: a 3 m/s updraft climbs without flapping (m/s)" % sp)
		eq(fx.events["flapped"], 0, "%s: no flaps" % sp)
		await _done()


# --- 7. Controls disabled while the arms keep waving ----------------------------------------

func test_r5x_controls_disabled_ignores_the_arms() -> void:
	for sp in S3:
		await _new_fx(sp)
		var p := fx.player
		p.start_flying(Vector3(0, 200, 0), 0.0, 0.0)
		fx.run(1.0)
		p.set_controls_enabled(false)
		fx.run(0.5)
		var hdg0 := p.model.heading()
		var y0 := p.model.position.y
		fx.reset_events()
		# Frantic one-arm flapping, a wrist twisted, the other arm raised.
		fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
			b.set_airplane()
			ScriptedPoseSource.flap(b, t, 60.0, 1.8, -1)
			b.arms[1].dihedral = 30.0 * DEG
			b.arms[1].twist = 35.0 * DEG
		var mx := {"bank": 0.0}
		fx.on_tick = func(_i: int, f: Variant) -> void:
			mx["bank"] = maxf(mx["bank"], absf(f.player.model.phi))
		fx.run(5.0)
		var dh := rad_to_deg(absf(FlightMath.wrap_angle(p.model.heading() - hdg0)))
		_log("%s controls disabled + frantic arms 5 s: flap events %d, max bank %.2f deg, heading change %.2f deg, dy %.2f m" % [
			sp, fx.events["flapped"], rad_to_deg(mx["bank"]), dh, p.model.position.y - y0])
		eq(fx.events["flapped"], 0, "%s: no flap events while controls are off" % sp)
		lt(rad_to_deg(mx["bank"]), 3.0, "%s: arms ignored, wings level (deg)" % sp)
		lt(dh, 3.0, "%s: no turn while controls are off (deg)" % sp)
		lt(p.model.position.y - y0, 0.0, "%s: no climb from ignored strokes" % sp)
		await _done()


# --- 1b. Resume diagnosis: which part of the resume makes the wingbeat --------------------

## variant "jump": the pause jump into the menu pose, held 1.5 s (no easing).
## variant "ease": no pause; in flight the right arm eases from +35 deg (and
## swept 60 deg forward) down to the airplane pose over 0.8 s, the left from
## -80 deg up: the resume's arm motion alone.
## variant "lower": no pause; only the right arm lowers 35 deg -> 0 over 0.8 s.
func _resume_variant(sp: StringName, variant: String) -> Dictionary:
	await _new_fx(sp)
	var p := fx.player
	p.start_flying(Vector3(0, 120, 0), 0.0, 0.0)
	var st := {"phase": 0, "t0": 0.0, "ev_t": [], "maxf": 0.0}
	fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
		b.set_airplane()
		if variant == "jump" or variant == "jump_ease":
			if st["phase"] == 1 and variant == "jump_ease":
				var k2 := clampf((t - float(st["t0"])) / 0.8, 0.0, 1.0)
				var e2 := k2 * k2 * (3.0 - 2.0 * k2)
				b.arms[0].dihedral = lerpf(-80.0 * DEG, 0.0, e2)
				b.arms[1].dihedral = lerpf(35.0 * DEG, 0.0, e2)
				b.arms[1].sweep = lerpf(60.0 * DEG, 0.0, e2)
				b.arms[1].elbow = lerpf(20.0 * DEG, 0.0, e2)
			elif st["phase"] == 1:
				b.arms[0].dihedral = -80.0 * DEG
				b.arms[1].dihedral = 35.0 * DEG
				b.arms[1].sweep = 60.0 * DEG
				b.arms[1].elbow = 20.0 * DEG
		elif variant == "ease" or variant == "lower":
			var k := clampf((t - 2.0) / 0.8, 0.0, 1.0)
			var e := k * k * (3.0 - 2.0 * k)
			if t < 2.0:
				e = 0.0
			b.arms[1].dihedral = lerpf(35.0 * DEG, 0.0, e)
			if variant == "ease":
				b.arms[0].dihedral = lerpf(-80.0 * DEG, 0.0, e)
				b.arms[1].sweep = lerpf(60.0 * DEG, 0.0, e)
				b.arms[1].elbow = lerpf(20.0 * DEG, 0.0, e)
	if variant.begins_with("jump"):
		fx.run(2.0)
	else:
		fx.run(1.0)
	if variant.begins_with("jump"):
		st["phase"] = 1
		st["t0"] = fx.src.tick * DT
		p.notification(Node.NOTIFICATION_UNPAUSED)
	fx.reset_events()
	var t0 := fx.ticks
	fx.on_tick = func(i: int, f: Variant) -> void:
		var pl: PlayerBird = f.player
		st["maxf"] = maxf(st["maxf"], absf(pl.model.flap_n) / (pl.mass * 9.81))
		if pl.wing_state().onset_l or pl.wing_state().onset_r:
			st["ev_t"].append("%.2f%s" % [(i - t0) * DT, "L" if pl.wing_state().onset_l else "R"])
	fx.run(3.0)
	var out := {"flaps": fx.events["flapped"], "onsets": st["ev_t"], "maxf": st["maxf"]}
	await _done()
	return out


