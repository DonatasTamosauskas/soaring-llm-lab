func test_r5x_glide_into_the_ground() -> void:
	for sp in S3:
		for pitch_trim in [0.0, 0.4, -0.4]:
			await _new_fx(sp)
			var p := fx.player
			var pr := p.model.params
			p.start_flying(Vector3(0, 6.0 * pr.span + 2.0, 0), 0.0, pitch_trim)
			var tw := 0.0 if absf(pitch_trim) < 0.01 else (28.0 if pitch_trim > 0.0 else -22.0)
			fx.driver = func(_tick: int, _t: float, b: HumanPoseModel) -> void:
				b.set_airplane()
				b.arms[0].twist = tw * DEG
				b.arms[1].twist = tw * DEG
			fx.reset_events()
			var st := {"ground_t": -1.0, "first_contact": "", "v_touch": 0.0, "vz_touch": 0.0, "max_dec": 0.0, "lastv": p.model.velocity}
			fx.on_tick = func(i: int, f: Variant) -> void:
				var pl: PlayerBird = f.player
				var dv: Vector3 = (pl.model.velocity - st["lastv"]) / DT
				st["lastv"] = pl.model.velocity
				st["max_dec"] = maxf(st["max_dec"], dv.length() / 9.81)
				if st["first_contact"] == "" and pl.last_contact != PlayerBird.Contact.NONE:
					st["first_contact"] = ["none", "silent", "slide", "land", "stun"][pl.last_contact]
				if st["ground_t"] < 0.0 and pl.mode == PlayerBird.Mode.GROUNDED:
					st["ground_t"] = i * DT
			var v0 := p.model.airspeed()
			fx.run(15.0)
			_log("%s glide into the ground (pitch trim %+.1f, V0 %.1f m/s = %.2f V_min): first contact %s, stuns %d, slides %d, grounded at %.2f s, mode %s, peak decel %.1f g" % [
				sp, pitch_trim, v0, v0 / pr.v_min, st["first_contact"], p.contacts["stun"], p.contacts["slide"], st["ground_t"], p.mode_name(), st["max_dec"]])
			if pitch_trim >= 0.0:
				eq(p.contacts["stun"], 0, "%s pitch %+.1f: a gentle glide into flat ground is not a stun" % [sp, pitch_trim])
				check(float(st["ground_t"]) > 0.0, "%s pitch %+.1f: comes to rest on the ground" % [sp, pitch_trim])
			fx.assert_comfort(self, "%s ground glide" % sp)
			await _done()


# --- 9. Turn around on a perch, then launch --------------------------------------------------

func test_r5x_turn_around_on_the_perch_then_launch() -> void:
	for sp in S3:
		await _new_fx(sp, func(w: Variant) -> void: w.add_perch(Vector3(0, 30, 0), Vector3.FORWARD, 10.0, 0.02, 1.0))
		var p := fx.player
		p.perch_on(fx.world.get_perches()[0])
		var rig0 := p.rig_yaw
		var st := {"launch_t": -1.0, "rig_moved": 0.0}
		fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
			b.set_airplane()
			# 1-2.5 s: the player turns round 120 deg to the left (whole body).
			var k := clampf((t - 1.0) / 1.5, 0.0, 1.0)
			b.torso_yaw = k * 120.0 * DEG
			if t >= 4.0 and t < 6.0:
				ScriptedPoseSource.flap(b, t - 4.0, 45.0, 1.0)
		fx.on_tick = func(i: int, f: Variant) -> void:
			var pl: PlayerBird = f.player
			if pl.mode == PlayerBird.Mode.PERCHED:
				st["rig_moved"] = maxf(st["rig_moved"], absf(FlightMath.wrap_angle(pl.rig_yaw - rig0)))
			if st["launch_t"] < 0.0 and pl.mode == PlayerBird.Mode.FLYING:
				st["launch_t"] = i * DT
		fx.run(4.0)
		var hdg_perched := rad_to_deg(p.model.heading())
		fx.run(4.0)
		var hdg_fly := rad_to_deg(p.model.heading())
		var vel := p.model.velocity
		var track := rad_to_deg(FlightMath.yaw_of(vel)) if Vector2(vel.x, vel.z).length() > 0.1 else NAN
		_log("%s turn round 120 deg on the perch: perched heading %.1f deg, rig yaw moved %.2f deg while perched, launched at %.2f s, heading 2 s after launch %.1f deg, track %.1f deg, mode %s" % [
			sp, hdg_perched, rad_to_deg(st["rig_moved"]), st["launch_t"], hdg_fly, track, p.mode_name()])
		near(hdg_perched, 120.0, 5.0, "%s: turning round on the perch turns the bird (deg)" % sp)
		lt(rad_to_deg(st["rig_moved"]), 1.0, "%s: the view is not rotated while perched (deg)" % sp)
		check(float(st["launch_t"]) > 0.0, "%s: the flap launches" % sp)
		near(hdg_fly, 120.0, 15.0, "%s: flies off the way the player faces (deg)" % sp)
		fx.assert_comfort(self, "%s perch turn" % sp)
		await _done()


