# --- Evidence plot: landing on the ground -------------------------------------------------------

func _series(sp: StringName, flare_twist: float, flare_h: float, seconds: float) -> Dictionary:
	await _new_fx(sp)
	var p := fx.player
	var pr := p.model.params
	p.start_flying(Vector3(0, 6.0 * pr.span + 2.0, 0), 0.0, 0.0)
	var s := {"t": PackedFloat64Array(), "belly": PackedFloat64Array(), "v": PackedFloat64Array(), "flare": -1.0, "flare_t": -1.0,
		"ground": -1.0, "stun": -1.0}
	fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
		b.set_airplane()
		if float(s["flare"]) >= 0.0:
			var k := clampf((t - float(s["flare"])) / 0.3, 0.0, 1.0)
			b.arms[0].twist = k * flare_twist * DEG
			b.arms[1].twist = k * flare_twist * DEG
	fx.on_tick = func(i: int, f: Variant) -> void:
		var pl: PlayerBird = f.player
		var tt := i * DT
		var belly: float = pl.model.position.y - pl.model.params.r_body
		if flare_twist > 0.0 and float(s["flare"]) < 0.0 and belly < flare_h * pl.model.params.span:
			s["flare"] = fx.src.tick * DT
			s["flare_t"] = tt
		if float(s["ground"]) < 0.0 and pl.mode == PlayerBird.Mode.GROUNDED:
			s["ground"] = tt
		if float(s["stun"]) < 0.0 and pl.mode == PlayerBird.Mode.STUNNED:
			s["stun"] = tt
		if i % 3 == 0:
			var a: PackedFloat64Array = s["t"]
			a.append(tt)
			s["t"] = a
			var bb: PackedFloat64Array = s["belly"]
			bb.append(belly / pl.model.params.span)
			s["belly"] = bb
			var vv: PackedFloat64Array = s["v"]
			vv.append(pl.model.airspeed() / pl.model.params.v_min if pl.mode == PlayerBird.Mode.FLYING or pl.mode == PlayerBird.Mode.STUNNED else 0.0)
			s["v"] = vv
	fx.run(seconds)
	await _done()
	return s


func test_r5x_zz_ground_landing_plot() -> void:
	var pl := FlightPlot.new(1600, 1000, "Verifier r5 (experience): gliding into a meadow - the skim, the flare and the landing")
	pl.note("Top: a neutral glide into flat ground (arms spread, no input). Belly height in spans and airspeed / V_min while FLYING (0 once GROUNDED). The eagle 'flies' on the grass below V_min for 15 s and comes to rest after 45 s. Bottom: the full flare (wrists +40 deg) begun 1 span above the grass: the sparrow balloons 10 spans, stalls and is stunned by the drop; the pigeon and eagle float 45 / 28 spans first.")
	var W := 760
	var H := 400
	var p1 := pl.panel(Rect2i(60, 150, W, H), "Neutral glide: belly height (spans)", "t (s)", "spans")
	var p2 := pl.panel(Rect2i(60 + W + 40, 150, W, H), "Neutral glide: airspeed / V_min (0 = grounded)", "t (s)", "V / V_min")
	var p3 := pl.panel(Rect2i(60, 150 + H + 60, W, H - 20), "Full flare from 1 span: belly height (spans)", "t since flare (s)", "spans")
	var p4 := pl.panel(Rect2i(60 + W + 40, 150 + H + 60, W, H - 20), "Full flare from 1 span: airspeed / V_min", "t since flare (s)", "V / V_min")
	var slot := 0
	for sp in S3:
		var a: Dictionary = await _series(sp, 0.0, 0.0, 50.0)
		p1.line(a["t"], a["belly"], slot, "%s (grounded %.0f s)" % [sp, a["ground"]])
		p2.line(a["t"], a["v"], slot, sp)
		var b: Dictionary = await _series(sp, 40.0, 1.0, 16.0)
		var ts := PackedFloat64Array()
		for x in b["t"]:
			ts.append(x - float(b["flare_t"]))
		p3.line(ts, b["belly"], slot, "%s%s" % [sp, " (STUNNED)" if float(b["stun"]) > 0.0 else ""])
		p4.line(ts, b["v"], slot, sp)
		slot += 1
	p2.hline(1.0, FlightPlot.AXIS, "V_min")
	p2.hline(0.7, FlightPlot.AXIS, "0.7 V_min (land)")
	p4.hline(1.0, FlightPlot.AXIS, "V_min")
	p3.set_x(-1.0, 12.0)
	p4.set_x(-1.0, 12.0)
	var path := Paths.artifacts("flight").path_join("verify/r6_builder/r5exp/r5x_ground_landing.png")
	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	eq(pl.save(path), OK, "plot saved")
	_log("plot: " + path)
