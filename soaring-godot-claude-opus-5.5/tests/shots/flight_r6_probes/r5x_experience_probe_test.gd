# --- 8b. Ground glide trace, and the natural flare landing ---------------------------------------

func _ground_trace(sp: StringName, flare_twist: float, seconds: float, flare_h := 0.6) -> Dictionary:
	await _new_fx(sp)
	var p := fx.player
	var pr := p.model.params
	p.start_flying(Vector3(0, 6.0 * pr.span + 2.0, 0), 0.0, 0.0)
	var st := {"flare_t": -1.0, "ground_t": -1.0, "lines": PackedStringArray(), "v_land": 0.0, "cam_step": 0.0,
		"lastc": p.camera.global_position, "lastv": Vector3.ZERO, "max_dv_perc": 0.0, "dist_after_flare": 0.0, "z_flare": 0.0}
	fx.driver = func(_tick: int, t: float, b: HumanPoseModel) -> void:
		b.set_airplane()
		if float(st["flare_t"]) >= 0.0:
			var k := clampf((t - float(st["flare_t"])) / 0.3, 0.0, 1.0)
			b.arms[0].twist = k * flare_twist * DEG
			b.arms[1].twist = k * flare_twist * DEG
	fx.on_tick = func(i: int, f: Variant) -> void:
		var pl: PlayerBird = f.player
		var tt := i * DT
		var agl: float = pl.model.position.y - pl.model.params.r_body
		if flare_twist > 0.0 and float(st["flare_t"]) < 0.0 and agl < flare_h * pl.model.params.span:
			st["flare_t"] = fx.src.tick * DT
			st["z_flare"] = pl.model.position.z
		# Perceived camera velocity change per tick (m/s, / world_scale).
		var cam := pl.camera.global_position
		var cv: Vector3 = (cam - st["lastc"]) / DT / maxf(pl.origin.world_scale, 1e-4)
		if i > 2:
			st["max_dv_perc"] = maxf(st["max_dv_perc"], (cv - st["lastv"]).length())
		st["lastc"] = cam
		st["lastv"] = cv
		if st["ground_t"] < 0.0 and pl.mode == PlayerBird.Mode.GROUNDED:
			st["ground_t"] = tt
			st["v_land"] = (st["lastv"] as Vector3).length()
		if i % 144 == 0:
			var ls: PackedStringArray = st["lines"]
			ls.append("t=%.0f belly %.2f m V %.2f V_min vz %+.2f mode %s" % [tt, agl, pl.model.airspeed() / pl.model.params.v_min, pl.model.velocity.y, pl.mode_name()])
			st["lines"] = ls
	fx.run(seconds)
	var out := {"ground_t": st["ground_t"], "flare_t": st["flare_t"], "stuns": p.contacts["stun"], "slides": p.contacts["slide"],
		"mode": p.mode_name(), "lines": st["lines"], "max_dv_perc": st["max_dv_perc"], "ws": p.origin.world_scale,
		"roll_out": absf(p.model.position.z - float(st["z_flare"])) if float(st["flare_t"]) >= 0.0 else -1.0,
		"agl": p.model.position.y - pr.r_body, "v": p.model.airspeed() / pr.v_min, "contacts": p.contacts.duplicate()}
	await _done()
	return out


